# Copy this file to .env.local for LOCAL development only:
#   cp .env.example .env.local && chmod 600 .env.local
# .env.local is ignored by Git. Production defaults need no Vercel dashboard secret.

# Next.js development proxy. The browser still calls same-origin /api/*.
PECHE_TN_API_ORIGIN=http://127.0.0.1:8000

# API runtime
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Free/keyless upstream services, called server-side.
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
AVIATION_WEATHER_METAR_URL=https://aviationweather.gov/api/data/metar
OVERPASS_SERVERS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
UPSTREAM_TIMEOUT_SECONDS=15

# Google Developer API connector configuration — these are not secrets.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash

# GEMINI KEY CONTRACT
# - Do NOT put a Gemini API key in this file, Vercel, Git, source code, or the ZIP.
# - The user enters the key at runtime in the report UI after seeing the localStorage warning.
# - The browser sends it transiently in X-Gemini-API-Key over HTTPS; the API forwards it
#   to Google in x-goog-api-key and does not persist, cache, or log the value.
# - localStorage is persistent but is NOT a secure vault; use a restricted/revocable key.
# - Never introduce NEXT_PUBLIC_* secrets: those values are shipped in the bundle.
